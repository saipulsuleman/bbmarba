# Port server lokal (default 3000)
PORT=3000

# Kredensial Supabase (Dapatkan dari Project Settings -> API di dashboard Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Secret untuk sesi login (bisa sembarang string acak)
JWT_SECRET=spbu_marisa_wings_bbm_secret_key_2024_secure

# Google Apps Script Webhook URL (untuk auto sync ke Spreadsheet Manager Keuangan & Operasional)
# Dapatkan setelah deploy Web App di Google Sheets -> Extensions -> Apps Script
GOOGLE_SHEETS_WEBHOOK_URL=

# Timezone
TZ=Asia/Makassar
